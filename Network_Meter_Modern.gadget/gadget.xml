<?xml version="1.0" encoding="utf-8"?>
<gadget>
  <name>Network Meter Modern</name>
  <namespace>ModernMeters</namespace>
  <version>1.9.1</version>
  <author name="Livonian Labs">
    <info url="https://github.com/livonianlabs/modern-meters" text="github.com/livonianlabs/modern-meters" />
    <logo src="icon.png" />
  </author>
  <copyright>© 2026 Livonian Labs</copyright>
  <description>Download/upload speed with an auto-scaled history graph, Wi-Fi network and signal, internal/external IP, firewall state and traffic totals.</description>
  <icons>
    <icon height="100" width="100" src="icon.png" />
  </icons>
  <hosts>
    <host name="sidebar">
      <base type="HTML" apiVersion="1.0.0.0" src="gadget.html" />
      <permissions>Full</permissions>
      <platform minPlatformVersion="1.0" />
      <defaultImage src="icon.png" />
      <autoscaleDPI>true</autoscaleDPI>
    </host>
  </hosts>
</gadget>
