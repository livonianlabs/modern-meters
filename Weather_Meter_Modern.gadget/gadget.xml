<?xml version="1.0" encoding="utf-8"?>
<gadget>
  <name>Weather Meter Modern</name>
  <namespace>ModernMeters</namespace>
  <version>1.1.0</version>
  <author name="Silverenio">
    <info url="https://github.com/Silverenio/modern-meters" text="github.com/Silverenio/modern-meters" />
    <logo src="icon.png" />
  </author>
  <copyright>© 2026 Silverenio</copyright>
  <description>Current weather and a colored hourly chart of temperature, precipitation, wind or pressure, with a few days ahead. Follows your location through Windows. Data by Open-Meteo.com.</description>
  <icons>
    <icon height="100" width="100" src="icon.png" />
  </icons>
  <hosts>
    <host name="sidebar">
      <base type="HTML" apiVersion="1.0.0.0" src="gadget.html" />
      <permissions>Full</permissions>
      <platform minPlatformVersion="1.0" />
      <defaultImage src="icon.png" />
      <autoscaleDPI>true</autoscaleDPI>
    </host>
  </hosts>
</gadget>
